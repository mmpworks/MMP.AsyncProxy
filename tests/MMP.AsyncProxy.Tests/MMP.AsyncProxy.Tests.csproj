<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tests run on net48, which executes the net35-built library binary on the
         .NET Framework CLR. The test project itself may use modern C#. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Which MMP.AsyncProxy.dll the suite loads. The default is the net35 build. tools/netcf-build.ps1
         passes the Compact Framework build's folder instead, so the same suite proves both. -->
    <AsyncProxyDllDir Condition="'$(AsyncProxyDllDir)' == ''">..\..\src\MMP.AsyncProxy\bin\$(Configuration)\net35\</AsyncProxyDllDir>
    <ForecourtDllDir Condition="'$(ForecourtDllDir)' == ''">..\..\samples\MMP.AsyncProxy.Forecourt\bin\$(Configuration)\net35\</ForecourtDllDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the net35 build outputs directly, so the tests prove the
         3.5-targeted binaries work, never a net48 recompile of the same source.
         The ProjectReference with ReferenceOutputAssembly=false only orders the build. -->
    <ProjectReference Include="..\..\src\MMP.AsyncProxy\MMP.AsyncProxy.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net35" />
    <ProjectReference Include="..\..\samples\MMP.AsyncProxy.Samples\MMP.AsyncProxy.Samples.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="MMP.AsyncProxy">
      <HintPath>$(AsyncProxyDllDir)MMP.AsyncProxy.dll</HintPath>
    </Reference>
    <Reference Include="MMP.AsyncProxy.Samples">
      <HintPath>..\..\samples\MMP.AsyncProxy.Samples\bin\$(Configuration)\net35\MMP.AsyncProxy.Samples.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\..\samples\MMP.AsyncProxy.Forecourt\MMP.AsyncProxy.Forecourt.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="MMP.AsyncProxy.Forecourt">
      <HintPath>$(ForecourtDllDir)MMP.AsyncProxy.Forecourt.dll</HintPath>
    </Reference>
    <!-- The SDK guide's code, net35 like the rest. -->
    <ProjectReference Include="..\..\samples\MMP.AsyncProxy.Sdk\MMP.AsyncProxy.Sdk.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="MMP.AsyncProxy.Sdk">
      <HintPath>..\..\samples\MMP.AsyncProxy.Sdk\bin\$(Configuration)\net35\MMP.AsyncProxy.Sdk.dll</HintPath>
    </Reference>
    <!-- The comparison console is net48 and would bring the net48 library with it, so SampleProgramTests
         runs its exe as a process. This reference only orders the build. -->
    <ProjectReference Include="..\..\samples\MMP.AsyncProxy.Comparison\MMP.AsyncProxy.Comparison.csproj" ReferenceOutputAssembly="false" />
    <!-- The real compiler's async method, net48, no library dependency, so a direct reference is safe. -->
    <ProjectReference Include="..\..\samples\MMP.AsyncProxy.CompilerReference\MMP.AsyncProxy.CompilerReference.csproj" />
  </ItemGroup>

</Project>
