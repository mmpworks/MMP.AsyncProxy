<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net35 is the target this library exists for. net48 lets the same source
         run under a modern test runner. netstandard2.0 lets a modern .NET app
         reference the same source. All three compile with C# 3 syntax only, so
         nothing newer than the Visual Studio 2008 compiler can slip in. -->
    <TargetFrameworks>net35;net48;netstandard2.0</TargetFrameworks>
    <LangVersion>3</LangVersion>
    <RootNamespace>MMP.AsyncProxy</RootNamespace>
    <AssemblyName>MMP.AsyncProxy</AssemblyName>
    <Description>The async/await state machine, written by hand for .NET 3.5. Futures, awaiters, a method builder, and an iterator-driven proxy that lets C# 2.0 iterators stand in for the compiler.</Description>

    <!-- SDK packaging. `dotnet pack -c Release` drops a .nupkg with net35 and net48 in artifacts/. -->
    <PackageId>MMP.AsyncProxy</PackageId>
    <Version>0.1.0</Version>
    <PackageTags>async;await;net35;state-machine;futures;promise;iterator;compact-framework</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mmpworks/MMP.AsyncProxy</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
