<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The SDK guide, as code. Every ```csharp block in docs/sdk.md is a method in one of
         these files, one file per section of the guide, and tests/MMP.AsyncProxy.Tests/SdkTests.cs
         runs each one. net35 and C# 3, so a Visual Studio 2008 team can paste any of it. -->
    <TargetFramework>net35</TargetFramework>
    <LangVersion>3</LangVersion>
    <RootNamespace>MMP.AsyncProxy.Sdk</RootNamespace>
    <AssemblyName>MMP.AsyncProxy.Sdk</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\MMP.AsyncProxy\MMP.AsyncProxy.csproj" />
  </ItemGroup>

</Project>
