<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console you can run. net48 so `dotnet run` works on a modern Windows box
         with no 3.5 install. Still C# 3, so the code reads like the rest. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>3</LangVersion>
    <RootNamespace>MMP.AsyncProxy.Comparison</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\MMP.AsyncProxy\MMP.AsyncProxy.csproj" />
  </ItemGroup>

</Project>
