         Visual Studio 2008 compiler would accept them. -->
    <TargetFramework>net35</TargetFramework>
    <LangVersion>3</LangVersion>
    <RootNamespace>MMP.AsyncProxy.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\MMP.AsyncProxy\MMP.AsyncProxy.csproj" />
  </ItemGroup>

</Project>
