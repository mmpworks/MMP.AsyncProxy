<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The real thing, for decompiling. A genuine C# 5 async method on net48,
         so ilspycmd can show what the compiler emits beside our hand-written machine.
         Build Release: the compiler emits a struct machine there, a class in Debug. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MMP.AsyncProxy.CompilerReference</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
